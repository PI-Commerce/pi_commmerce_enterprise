# Live Thesys Ask Pi (Analytics surface). Copy to `.env` (gitignored) and fill in.
# Without these the Analytics Ask Pi still works — it falls back to the captured static fixtures.

# Thesys C1 API key (server-side only; never exposed to the browser).
THESYS_API_KEY=

# Optional. Defaults to the paid Sonnet C1 model; set this to a free model slug to stay on the free tier.
# THESYS_MODEL=

# TrueFoundry LLM (Phase 3). Powers live Ask Pi calls: reason over the campaign
# DSL, mutate node config, and answer analytics questions with real data. The
# endpoint is OpenAI-compatible; both vars are server-side only and never
# exposed to the browser.
TFY_API_KEY=
TFY_BASE_URL=https://tfy.internal.ap-south-1.production.apps.pai.mypaytm.com/api/llm
# Optional. Defaults to a Claude model available on the tenant. Override to pin a slug.
# TFY_MODEL=
